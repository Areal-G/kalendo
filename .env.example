# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The app connects as `kalendo_app`: NOSUPERUSER, NOBYPASSRLS. Every tenant
# query is filtered by Postgres Row Level Security. The role and its password
# are created/updated by `npm run db:migrate` from this URL.
DATABASE_URL=postgres://kalendo_app:kalendo_app_dev_password@localhost:5433/kalendo
# Privileged connection used ONLY for migrations, seeding and test setup.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/kalendo
#
# Neon / Vercel: DATABASE_URL = kalendo_app on the *pooled* host (-pooler),
# DATABASE_ADMIN_URL = neondb_owner on the *direct* host, both ?sslmode=require.
# Pick a long random kalendo_app password: the first migration creates the role
# with it. Prepared statements are disabled automatically on "-pooler" hosts.
#
# With the Neon integration (owner URLs in DATABASE_URL / DATABASE_URL_UNPOOLED)
# set DATABASE_APP_PASSWORD instead: both connections are derived from it.
DATABASE_URL_UNPOOLED=
DATABASE_APP_PASSWORD=
# 1 = disable prepared statements for a transaction-mode pooler on another host.
DATABASE_POOLED=

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (Mailpit in docker-compose catches everything: http://localhost:8025)
# ---------------------------------------------------------------------------
# smtp (default) | log (print a one-line summary, send nothing) | memory (tests).
MAIL_TRANSPORT=
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Kalendo <no-reply@kalendo.local>"

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to use the built-in fake provider: deposits go
# through a local checkout page and a signed fake webhook, exercising the exact
# same idempotency + outbox code path as real Stripe events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
FAKE_PAYMENTS_WEBHOOK_SECRET=dev-fake-webhook-secret

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Bearer token for /api/cron/outbox (Vercel Cron sends it). Without it the
# endpoint rejects every call. Generate: openssl rand -hex 32
CRON_SECRET=
# How often `npm run worker` polls the outbox, in milliseconds (default 1000).
# WORKER_POLL_MS=1000

# ---------------------------------------------------------------------------
# Sample data (`npm run seed`, local only)
# ---------------------------------------------------------------------------
# The login that owns the two sample businesses. Defaults: Emily Carter,
# owner@example.com, kalendo-local-password.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Tests (read from the shell, not this file; defaults in vitest/playwright config)
# ---------------------------------------------------------------------------
# Integration tests: app-role and privileged URLs of a dedicated test database.
# TEST_DATABASE_URL=postgres://kalendo_app:kalendo_app_dev_password@localhost:5433/kalendo_test
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/kalendo_test
# Playwright: port for the local server, or an already running app to test
# instead, the command that starts it, and PW_CHANNEL=chrome to use local Chrome.
# E2E_PORT=3000
# E2E_BASE_URL=
# E2E_SERVER_CMD=
# PW_CHANNEL=
#
# Set by the platform, not here: NODE_ENV, CI, VERCEL, CODESPACES,
# GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN.
