# Demo build: everything runs in memory, so the secret is the only variable
# you must set. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public base URL, inlined at build time (netlify.toml sets the production
# one). Also the default for BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Auth callback base URL, if it differs from NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=

# Emails are only logged. memory = keep in memory (tests), smtp = send via
# SMTP_HOST:SMTP_PORT from EMAIL_FROM (e.g. a local Mailpit).
MAIL_TRANSPORT=log
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Kalendo <no-reply@kalendo.local>"

# HMAC secret of the built-in fake payment provider (the demo never uses Stripe).
FAKE_PAYMENTS_WEBHOOK_SECRET=dev-fake-webhook-secret

# Only for `npm run db:generate` (drizzle-kit); the demo never connects to it.
# DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/kalendo

# Set by the platform, not here: NODE_ENV, CODESPACES, GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN.
